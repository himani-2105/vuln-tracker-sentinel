# Copy to .env for local use. NEVER commit real values.
VULNTRACK_ENV=development          # set to "production" on Render (enables Secure cookies, HSTS, requires SECRET_KEY)
SECRET_KEY=                        # >=32 random chars. Generate: python -c "import secrets;print(secrets.token_hex(32))"
DB_PATH=tracker.db                 # Render: /data/tracker.db (persistent disk mount path)
MAX_UPLOAD_MB=30
SESSION_HOURS=8
VULNTRACK_DEMO=0                   # 1 shows the DEMO DATA pill. Only for synthetic data.
# One-time bootstrap of the first admin (remove after first start). Min 12 chars.
INITIAL_ADMIN_USERNAME=
INITIAL_ADMIN_PASSWORD=
